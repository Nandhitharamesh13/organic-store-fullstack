# ── Ilai Foods — Environment Variables ───────────────────────
# Copy this file to .env and fill in your values before deploying.

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL (used to build password-reset links) ────────
# In development this auto-detects. Set this for production:
# FRONTEND_URL=https://yourdomain.com

# ── JWT Secrets (CHANGE THESE IN PRODUCTION!) ────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ilai_user_secret_CHANGE_IN_PROD_generate_64_random_bytes
ADMIN_JWT_SECRET=ilai_ADMIN_secret_CHANGE_IN_PROD_generate_64_random_bytes

# ── DB Viewer Token (optional, auto-generated if not set) ─────
# DB_VIEWER_TOKEN=your_token_here

# ── Email (nodemailer SMTP) ───────────────────────────────────
# Leave blank to use dev-mode (reset links appear in server console).
#
# Gmail example:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=your@gmail.com
#   EMAIL_PASS=your_app_password   ← Gmail App Password, NOT your main password
#   EMAIL_FROM=Ilai Foods <your@gmail.com>
#
# Other providers (Brevo, Mailgun, SendGrid, etc.) — check their SMTP docs.

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Ilai Foods <noreply@ilaifoods.com>
